# macOS cruft (this repo lives on a non-APFS external drive that generates these constantly)
._*
.DS_Store

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Secrets — never commit real env files, only the .example ones
.env
*.env
!*.env.example

# Editors
.vscode/
.idea/

# Model weights — never commit (large binaries; download/train instead, see backend/README.md)
*.pt
backend/models/*
!backend/models/.gitkeep

# ai-pipeline/ has its own more specific .gitignore too (data/, runs/, reports/, etc.)

# Node (review-console)
node_modules/
dist/
dist-ssr/
*.local
