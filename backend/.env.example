# Copy to .env for local (non-docker) runs. In docker-compose these are set inline.
DATABASE_URL=postgresql+psycopg2://rotaai:rotaai@localhost:5432/rotaai
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./_images

# Model seam (docs/02-ai-pipeline.md). Leave WEIGHTS_PATH empty to run the STUB.
# Set it to the Stage-1 weights to run the real YOLO26 model — nothing else changes.
# WEIGHTS_PATH=/models/best.pt
DETECT_CONF=0.4
DETECTOR_VERSION=stub-0
